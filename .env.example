# Copy/edit into .env, or let scripts/bootstrap.py create one for you.
# .env is the SINGLE SOURCE OF TRUTH for all configuration.
# docker-compose.yml references ${VAR} with no defaults — every variable
# must be defined here (or bootstrap.py will set the default for you).

# ── Docker images ────────────────────────────────────────────────────────
# Every image is pinned to a specific version.  To bump:
#   1. update the tag here
#   2. `make up` (pulls the new image)
#   3. validate, then commit
# For reproducibility against a known-working host, run `make pin-images`
# after `make up` to rewrite the IMAGE values in .env with current digests
# (@sha256:...).  .env.example stays at human-readable version tags.
CADDY_IMAGE=caddy:2.8.4-alpine
PHOENIX_IMAGE=arizephoenix/phoenix:version-14.12.0
LITELLM_DB_IMAGE=postgres:16.4-alpine
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.83.7-stable
CHROMA_IMAGE=chromadb/chroma:1.5.5
SURREALDB_IMAGE=surrealdb/surrealdb:v2.1.4
OPEN_NOTEBOOK_IMAGE=lfnovo/open_notebook:v1.8.5
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.1
# mcpo publishes no version tags — pin to a git-SHA for reproducibility,
# or use :main (floating).  Run `make pin-images` after `make up` to
# freeze the digest of whatever you pulled.
MCPO_IMAGE=ghcr.io/open-webui/mcpo:main
OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal:0.10.2
AGENTREGISTRY_IMAGE=agentregistry-server:latest
PRESIDIO_ANALYZER_IMAGE=mcr.microsoft.com/presidio-analyzer:latest
PRESIDIO_ANONYMIZER_IMAGE=mcr.microsoft.com/presidio-anonymizer:latest

# ── Onyx (alternative frontend — see docs/deployment-seams.md) ────────────
ONYX_BACKEND_IMAGE=onyxdotapp/onyx-backend:latest
ONYX_WEB_IMAGE=onyxdotapp/onyx-web-server:latest
ONYX_MODEL_SERVER_IMAGE=onyxdotapp/onyx-model-server:latest

# ── Host ports ───────────────────────────────────────────────────────────
CADDY_PORT=8090
LITELLM_DB_PORT=5432
OPEN_NOTEBOOK_PORT=8502
OPENWEBUI_PORT=3000

# ── Phoenix (observability) ──────────────────────────────────────────────
PHOENIX_PROJECT_NAME=litellm-proxy
PHOENIX_ALLOW_EXTERNAL_RESOURCES=false
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=30

# ── Open WebUI ────────────────────────────────────────────────────────────
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.local
WEBUI_ADMIN_PASSWORD=__GENERATE__
WEBUI_SECRET_KEY=__GENERATE__
# Generate in Open WebUI: Settings → Account → API Keys (for CLI queries)
OPENWEBUI_API_KEY=

# ── LiteLLM ───────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=__GENERATE__
LITELLM_DB_PASSWORD=__GENERATE__

# ── Provider API keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GitHub personal access token (classic or fine-grained) with Copilot access.
# When set, registers claude-haiku-4.5 and claude-sonnet-4.6 via the Copilot API.
GITHUB_COPILOT_TOKEN=

# ── Azure OpenAI ──────────────────────────────────────────────────────────
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-06-01
AZURE_FAST_MODEL=
AZURE_STRONG_MODEL=
AZURE_EMBEDDING_MODEL=
AZURE_GPT52_MODEL=gpt-5.2
AZURE_GPT52_API_VERSION=2025-04-01-preview
AZURE_GPT41MINI_MODEL=gpt-4.1-mini

# ── Model aliases (referenced in config/litellm/config.yaml) ──────────────
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4.1
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
ANTHROPIC_STRONG_MODEL=claude-3-7-sonnet-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama ────────────────────────────────────────────────────────────────
# Rancher Desktop supports host.docker.internal and host.rancher-desktop.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Local models (Foundry, etc) ────────────────────────────────────────────
# Base URL for local model services (OpenAI-compatible API).
# Models from this endpoint will be registered with aliases like: local-<model-name>
# Rancher Desktop: use host.docker.internal instead of 127.0.0.1
# Example: http://host.docker.internal:59601
LOCAL_MODELS_ENDPOINT=

# ── Chat frontend (seam) ──────────────────────────────────────────────────
# Which chat frontend to use.  Controls Caddy routing and tool wiring.
# Options: openwebui (default, lean) | onyx (rich RAG + enterprise search)
# See docs/deployment-seams.md for details.
CHAT_FRONTEND=openwebui

# ── Guardrails (seam — see docs/deployment-seams.md) ──────────────────────
# Opt-in DLP + prompt-injection defense enforced at the LiteLLM gateway, so it
# covers every chat frontend (Open WebUI, Onyx) without touching either.
#   S2 DLP:       Presidio redacts PII/PHI before the model sees the prompt
#   S2 injection: regex heuristic blocks obvious prompt-injection/jailbreak text
# Enable with GUARDRAILS_ENABLED=true and `make up-guardrails` (profile: guardrails).
# No model required — both checks run entirely offline.
GUARDRAILS_ENABLED=false
PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
# Comma-separated Presidio entity types to redact. Leave blank for Presidio defaults.
PRESIDIO_PII_ENTITIES=CREDIT_CARD,EMAIL_ADDRESS,PHONE_NUMBER,PERSON,US_SSN,US_DRIVER_LICENSE,LOCATION,DATE_TIME
INJECTION_GUARDRAIL_ENABLED=true

# ── Default models ────────────────────────────────────────────────────────
DEFAULT_CHAT_MODEL=openai-fast
DEFAULT_REASONING_MODEL=
RAG_EMBEDDING_MODEL=embeddings
RAG_EMBEDDING_CONTENT_PREFIX=
RAG_EMBEDDING_QUERY_PREFIX=

# ── Corporate proxy / TLS ─────────────────────────────────────────────────
# Leave empty to disable. CA_BUNDLE_PATH is the *host* path; it is bind-mounted
# read-only into containers that make outbound HTTPS calls.
HTTPS_PROXY=
HTTP_PROXY=
WORKBENCH_NO_PROXY=localhost,127.0.0.1,litellm,litellm-db,chroma,phoenix,openwebui,surrealdb,open-notebook,caddy,host.docker.internal,code-agent,open-terminal,magic-fetch,mcpo,agentregistry,registry-db,mcp-time,mcp-fetch,onyx-api-server,onyx-web-server,onyx-background,onyx-db,onyx-cache,onyx-index,onyx-minio,onyx-model-server,onyx-nginx,presidio-analyzer,presidio-anonymizer
CA_BUNDLE_PATH=

# ── Agent model ──────────────────────────────────────────────────────────
# Used by MCP agents (e.g. code-agent)
AGENT_MODEL=azure-strong

# ── Optional integrations ─────────────────────────────────────────────────
# Full Authorization header value for LiteLLM's MCP gateway config.yaml
# (e.g. "Bearer <token>" or "Token abc123")
OREILLY_AUTH_HEADER=
# Token only (no "Bearer " prefix) — used by Open WebUI's direct MCP connection
OREILLY_API_KEY=

# ── Open Notebook ─────────────────────────────────────────────────────────
# Encryption key for storing API credentials in SurrealDB
OPEN_NOTEBOOK_ENCRYPTION_KEY=__GENERATE__

# ── Open Terminal ─────────────────────────────────────────────────────────
# API key for the sandboxed code execution service
OPEN_TERMINAL_API_KEY=__GENERATE__

# ── Agentregistry ────────────────────────────────────────────────────────
# Registry for MCP servers, agents, skills, and prompts
REGISTRY_DB_PASSWORD=__GENERATE__
REGISTRY_JWT_KEY=__GENERATE__
